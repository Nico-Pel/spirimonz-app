  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: City-Sergei
  m_EditorClassIdentifier: 
  npcName: Sergei
  lines:
  - english: The best way to make money is to find charms in haunted houses, even
      if sometimes you don't find any...
    french: "Le meilleur moyen de se faire du fric, c'est de trouver des gri-gris
      dans les maisons hant\xE9es, m\xEAme si parfois on en trouve pas..."
  - english: ...And if we manage to free the Spirimonz from its malevolent spirit
      form by capturing it, the charms become more valuable!
    french: "...Et si on arrive \xE0 lib\xE9rer le Spirimonz de sa forme d'esprit
      malveillant en le capturant, les gri-gris prennent de la valeur !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 0.9
    maxPitch: 1.1
  voiceType: 4
