  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: VanessTuto13
  m_EditorClassIdentifier: 
  npcName: Vaness
  lines:
  - english: Not bad! Now let's tackle the only proof that doesn't require the help
      of the Spirimonz.
    french: "Pas mal ! Maintenant on va s'attaquer \xE0 la seule preuve qui ne demande
      pas l'aide des spirimonz."
  - english: Press [Inventory1] to deselect any Spirimonz, and hold down [Secondary]
      to use your night-vision watch.
    french: "Appuie sur [Inventory1] pour ne pas selectionner de spirimonz et garde
      [Secondary] enfonc\xE9 pour utiliser ta montre \xE0 vision nocturne."
  - english: If you see glowing orbs through the watch screen in the haunted room,
      that means you've found more evidence!
    french: "Si dans la pi\xE8ce hant\xE9e tu vois des orbes lumineux \xE0 travers
      l'\xE9cran de la montre, c'est que tu as trouv\xE9 une preuve en plus !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
