  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: City-Sofia
  m_EditorClassIdentifier: 
  npcName: Sofia
  lines:
  - english: When I investigate a malevolent spirit and want to check if it likes
      fruit, I have my own little technique!
    french: "Quand j'enqu\xEAte un esprit malveillant et que je veux v\xE9rifier
      s'il aime les fruits j'ai ma petite technique !"
  - english: I place a piece of fruit where I think the spirit lurks and remove other
      objects from the vicinity!
    french: "Je pose un fruit o\xF9 je pense que l'esprit r\xF4de et je vire les
      autres objets des alentours !"
  - english: This way, there is a greater chance that he will decide to interact
      with the fruit, and hopefully eat it... or not!
    french: "Ainsi, il y a plus de chances qu'il d\xE9cide d'interagir avec le fruit
      et esp\xE9rer qu'il le mange... ou pas !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
