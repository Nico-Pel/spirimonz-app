  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: VanessTuto02
  m_EditorClassIdentifier: 
  npcName: Vaness
  lines:
  - english: Great, we can see a little better now... But I'm going to turn off the
      lights, and this time we'll use candles.
    french: "Super, on y voit un peu mieux... Mais je vais couper les lumi\xE8res
      et on va cette fois utiliser des bougies."
  - english: Look for a candle and pick it up, there must be one somewhere...
    french: Cherche une bougie et ramasse la, il doit bien y en avoir quelque part...
  - english: This is important because it's one of the three pieces of evidence you
      need to gather to figure out what kind of spirit you're dealing with!
    french: "C'est important car c'est l'une des 3 preuves \xE0 r\xE9colter pour
      savoir \xE0 quel type d'esprit on a affaire !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
