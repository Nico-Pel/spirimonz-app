  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: VanessTuto11
  m_EditorClassIdentifier: 
  npcName: Vaness
  lines:
  - english: 'You''re doing great! '
    french: "Tu te d\xE9brouilles bien !"
  - english: Great, we're making progress! Now I want you to find some spiritual
      footprints!
    french: Super on avance ! Maintenant je veux que tu trouves des empreintes spirituelles
      !
  - english: Get your third Spirimonz using [Inventory4]. You'll see, some Spirimonz
      can't be placed on the ground and have to stay in your hand.
    french: "\xC9quipe toi de ton troisi\xE8me spirimonz gr\xE2ce \xE0 [Inventory4].
      Tu verras, certains spirimonz ne peuvent pas \xEAtre pos\xE9 au sol et doivent
      rester dans ta main."
  - english: Use this ability by holding down [Secondary]. This will reveal fingerprints
      on certain doors or pieces of furniture that the malevolent spirit has interacted
      with.
    french: "Utilise son pouvoir en restant appuy\xE9 sur [Secondary]. Cela va r\xE9v\xE9ler
      les empreintes sur certaines portes ou meubles avec lesquels l'esprit malveillant
      a int\xE9ragit."
  - english: Be careful, sometimes your Spirimonz runs out of energy and needs a
      break.
    french: Attention, parfois ton spirimonz n'a plus d'energie et a besoin d'une
      pause.
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
