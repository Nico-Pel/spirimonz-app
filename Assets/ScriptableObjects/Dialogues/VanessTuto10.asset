  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: VanessTuto10
  m_EditorClassIdentifier: 
  npcName: Vaness
  lines:
  - english: "You're doing great! If you've ever witnessed a level 5 paranormal activity,
      it means you've found evidence of a \u201CSpirit Activity 5\"."
    french: "Tu te d\xE9brouilles bien ! Si jamais tu as vu une activit\xE9 paranormale
      de valeur 5, c'est que tu as trouv\xE9 une preuve \"Activit\xE9 spirituelle
      5\"."
  - english: "Now let's go back to your first Spirimonz\u2014it can detect cold coins
      because the color of its flame changes depending on the temperature."
    french: "Maintenant revenons sur ton premier Spirimonz, il peut d\xE9tecter les
      pi\xE8ces froides car la couleur de sa flamme s'adapte \xE0 la temp\xE9rature."
  - english: The flame is red when it's very hot, then turns orange, yellow, green,
      blue... And if it's REALLY freezing, it turns pink!
    french: "La flamme est rouge s'il fait tr\xE8s chaud, puis devient orange, jaune,
      verte, bleue... Et si la temp\xE9rature est VRAIMENT glaciale, elle devient
      rose !"
  - english: Walk around the house with your Spirimonz and try to find the coldest
      room. Stay there to see if the temperature drops to freezing!
    french: "Prom\xE8ne toi dans la maison avec ton spirimonz et tente de trouver
      la pi\xE8ce la plus froide. Reste y pour voir si la temp\xE9rature devient
      glaciale !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
