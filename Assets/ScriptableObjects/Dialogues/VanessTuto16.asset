  m_Script: {fileID: 11500000, guid: 81758906a27f94ab58d5f8a30936127b, type: 3}
  m_Name: VanessTuto16
  m_EditorClassIdentifier: 
  npcName: Vaness
  lines:
  - english: Well, you did pretty well... for a beginner.
    french: "Bon, tu t'es bien d\xE9brouill\xE9... pour un d\xE9butant."
  - english: Now it's your turn. I'm going to keep playing hide-and-seek. Watch out,
      or I'll catch you.
    french: "Maintenant \xE7a va \xEAtre \xE0 toi de jouer, je vais continuer de
      jouer les fant\xF4mes, attention \xE0 que je ne t'attrape pas."
  - english: "The door is open, so feel free to leave if you want, but when I'm out
      hunting, the door will be locked\u2014just like in real life!"
    french: "La porte est ouverte donc libre \xE0 toi de partir si tu veux, mais
      lorsque je serais en chasse, la porte sera bloqu\xE9e, comme en situation r\xE9elle
      !"
  - english: If you can figure out which type of evil spirit I'm imitating, I'll
      give you a Spirimonz, just as if you'd actually caught it!
    french: "Si tu r\xE9ussi \xE0 identifier le bon type d'esprit malveillant que
      j'imite, je t'offrirai un Spirimonz, comme si tu l'avais vraiment captur\xE9
      !"
  letterSoundProfile:
    baseBeep: {fileID: 0}
    minPitch: 1
    maxPitch: 1.2
  voiceType: 0
